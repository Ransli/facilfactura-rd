# Copia este archivo como .env.production antes de compilar el frontend para el servidor.
# Vite lo toma automáticamente con "npm run build" (el modo "production" es el de por defecto).
#
# URL completa de la API del backend EN EL SERVIDOR, terminada en /api.
# Si nginx sirve el frontend y reenvía /api al backend en el MISMO dominio (lo recomendado,
# ver docs/DESPLIEGUE.md), esto es simplemente la ruta /api de ese mismo dominio:
VITE_API_URL=https://tu-subdominio.tu-servidor.com/api
