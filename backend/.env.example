# Copia este archivo como .env y completa los valores

PORT=3002

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=facilfactura_saas

JWT_SECRET=cambia_esto_por_una_clave_secreta_larga
JWT_EXPIRES_IN=8h

UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=5

# ── Facturación electrónica (e-CF) ──
# Clave para cifrar los certificados digitales guardados: 32 bytes en hexadecimal (64 caracteres).
# Generar una:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se cambia, los certificados ya guardados dejan de poder leerse y hay que volver a subirlos.
CLAVE_CIFRADO_CERTIFICADOS=
# 1 = el servidor envía a la DGII los e-CF pendientes cada 30 segundos
ECF_TRABAJADOR=0
# Servicios de la DGII. Por omisión los reales; para desarrollar: npm run dgii:simulador y usar http://localhost:3900
DGII_URL_BASE=https://ecf.dgii.gov.do
