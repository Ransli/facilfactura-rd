{
  "name": "facilfactura-api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "seed": "node seed-usuarios.js",
    "db:create": "node scripts/create-db.js",
    "db:migrate": "knex migrate:latest --knexfile knexfile.js",
    "db:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "db:status": "knex migrate:status --knexfile knexfile.js",
    "db:seed": "knex seed:run --knexfile knexfile.js",
    "db:copy-v1": "node scripts/copy-from-v1.js",
    "pretest": "node tests/prepare-db.js",
    "dgii:simulador": "node services/ecf/simuladorDgii.js",
    "master:crear": "node scripts/crear-master.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "db:dump-schema": "node scripts/dump-schema.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "inquirer": "^9.3.6",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "multer": "^2.1.1",
    "mysql2": "^3.10.1",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.3.2",
    "xpath": "^0.0.34"
  }
}
