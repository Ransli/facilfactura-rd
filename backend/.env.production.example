# Copia este archivo como .env EN EL SERVIDOR (nunca en tu máquina de desarrollo ni en el repositorio).
# Completa cada valor antes de arrancar el proceso con PM2. Ver docs/DESPLIEGUE.md para el paso a paso completo.

PORT=3002

DB_HOST=localhost
DB_PORT=3306
DB_USER=facilfactura
DB_PASSWORD=pon-aqui-una-contraseña-propia-del-servidor
DB_NAME=facilfactura_saas

# Clave distinta a la de desarrollo, larga y aleatoria. Generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=5

# El dominio (con https://) desde el que nginx sirve el frontend compilado. Si frontend y API comparten dominio
# (lo recomendado, ver docs/DESPLIEGUE.md), esto casi nunca se usa, pero déjalo correcto por si acaso.
CORS_ORIGIN=https://tu-subdominio.tu-servidor.com

# ── Facturación electrónica (e-CF) ──
# Clave para cifrar los certificados digitales guardados: 32 bytes en hexadecimal (64 caracteres), DISTINTA a la
# de desarrollo. Generar una:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guárdala en un lugar seguro aparte: si se pierde o se cambia, los certificados ya guardados no se pueden leer.
CLAVE_CIFRADO_CERTIFICADOS=

# 1 = el servidor envía a la DGII los e-CF pendientes cada 30 segundos. Déjalo en 0 mientras el entorno sea solo
# de pruebas y no haya certificación real con la DGII, para no intentar enviar nada a producción por accidente.
ECF_TRABAJADOR=0
# Ambiente de pruebas de la DGII (no el real) hasta tener la certificación. Ver docs/escalacion/SPEC-ecf-connector.md.
DGII_URL_BASE=https://ecf.dgii.gov.do
